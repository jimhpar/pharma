    {
      "name": "Orders",
      "description": "Authenticated checkout and customer order history.",
      "item": [
        {
          "name": "Checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_id\": 1,\n      \"quantity\": 2\n    }\n  ],\n  \"shipping_address\": \"123 Main St, Dhaka\",\n  \"phone\": \"01700000000\",\n  \"coupon_code\": \"SAVE10\",\n  \"shipment_zone_id\": 1,\n  \"notes\": \"Please deliver in the morning\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders/checkout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders",
                "checkout"
              ]
            },
            "description": "Create a new order from cart-like payload. Requires a bearer token. When coupon_code is provided, checkout revalidates and records the coupon usage before applying the discount. When shipment_zone_id is provided, checkout uses the active zone's charge as shipping_fee and includes it in total_amount. Checkout deducts live stock from the active online branch warehouse and records sale inventory transactions."
          }
        },
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/orders?per_page=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            },
            "description": "Get paginated order history for the logged-in customer. Item SKU payloads include `selling_price`; nested `sku.product` payloads include product-level `selling_price`, matching product list/detail responses."
          }
        },
        {
          "name": "Order Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders",
                "{{order_id}}"
              ]
            },
            "description": "Get one order with item details. Item SKU payloads include `selling_price`; nested `sku.product` payloads include product-level `selling_price`, matching product list/detail responses."
          }
        },
        {
          "name": "Order Invoice",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}/invoice",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders",
                "{{order_id}}",
                "invoice"
              ]
            },
            "description": "Get invoice-oriented order payload for the logged-in customer."
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}/cancel",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders",
                "{{order_id}}",
                "cancel"
              ]
            },
            "description": "Cancel a pending order only. Cancellation restores the stock allocated during checkout and records sale_cancel inventory transactions."
          }
        }
      ]
    },
    {
      "name": "Wishlist",
      "description": "Wishlist is customer-scoped. All wishlist endpoints require login. Wishlist item SKU payloads include `selling_price`; nested `sku.product` payloads include product-level `selling_price`, matching product list/detail responses.",
      "auth": {
        "type": "bearer",
