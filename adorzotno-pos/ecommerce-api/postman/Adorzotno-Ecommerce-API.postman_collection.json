        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "description": "Register, login, inspect the current user, update profile, change password, and logout.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"phone\": \"01700000000\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Create a new customer-linked account and return a Sanctum token."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login with email and password. Copy `data.token` into the `api_token` collection variable for protected requests."
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Return the current authenticated user and linked customer profile."
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"phone\": \"01700000001\",\n  \"billing_address\": \"House 12, Road 5, Dhanmondi, Dhaka\",\n  \"shipping_address\": \"House 12, Road 5, Dhanmondi, Dhaka\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/update-profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "update-profile"
              ]
            },
            "description": "Update the logged-in user's profile and linked customer addresses. This endpoint does not change passwords."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current\": \"password123\",\n  \"new\": \"newpassword123\",\n  \"confirm\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/change-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "change-password"
              ]
            },
            "description": "Change the authenticated user's password. Also accepts `current_password`, `new_password`, and `new_password_confirmation` aliases."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Invalidate the current bearer token."
          }
        }
      ]
    },
    {
      "name": "Products",
      "description": "Browse products, categories, brands, banners, and storefront discovery endpoints. Product/category/brand detail routes use slugs. Product responses include live stock summaries from SKU stock balances.",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?page=1&per_page=20&category_slug=&brand_slug=&category_id=&brand_id=&min_price=&max_price=&in_stock=&sort_by=created_at&sort_order=desc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "20"
                },
                {
                  "key": "category_slug",
                  "value": "{{category_slug}}",
                  "disabled": true
                },
                {
                  "key": "brand_slug",
                  "value": "{{brand_slug}}",
                  "disabled": true
                },
                {
                  "key": "category_id",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "brand_id",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "min_price",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "max_price",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "in_stock",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "sort_by",
                  "value": "created_at"
                },
                {
                  "key": "sort_order",
                  "value": "desc"
                }
              ]
            },
            "description": "Paginated storefront product list. Use category_slug and brand_slug for new clients; category_id and brand_id remain as legacy optional filters. Responses include product-level and SKU-level stock summaries. The in_stock filter and sort_by=quantity use live available stock from stock_balances."
          }
        },
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products/search?q=vitamin&per_page=20&category_slug=&brand_slug=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "vitamin"
                },
                {
                  "key": "per_page",
                  "value": "20"
                },
                {
                  "key": "category_slug",
                  "value": "{{category_slug}}",
                  "disabled": true
                },
                {
                  "key": "brand_slug",
                  "value": "{{brand_slug}}",
                  "disabled": true
                }
              ]
            },
            "description": "Search active online products by name, short description, or long description. Optional filters mirror the product list. Responses include product-level and SKU-level stock summaries."
          }
        },
